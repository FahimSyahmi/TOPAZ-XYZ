# Optional Replicate GPU upscaling. Keep the token server-side; never use NEXT_PUBLIC_ here.
REPLICATE_API_TOKEN=
# Defaults to bytedance/video-upscaler. May also be an owner/name:version or version hash.
REPLICATE_MODEL_VERSION=bytedance/video-upscaler

# Auth.js + PostgreSQL authentication. Configure OAuth apps for localhost and your domain.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/topaz?sslmode=require
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
